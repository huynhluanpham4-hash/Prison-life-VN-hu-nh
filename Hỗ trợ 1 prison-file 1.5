--------------------------------------------------------------------------------
-- ANTI-LAG / OPTIMIZE TEXTURE LOGIC
--------------------------------------------------------------------------------
local function IsPlayerCharacter(object)
   for _, player in ipairs(Players:GetPlayers()) do
      if player.Character and object:IsDescendantOf(player.Character) then
         return true
      end
   end
   return false
end

local function OptimizeObject(v)
   if not AntiLagEnabled then return end
   
   if KeepPlayerSkins and IsPlayerCharacter(v) then
      return
   end

   if v:IsA("BasePart") and not v:IsA("MeshPart") then
      if not OriginalMaterials[v] then
         OriginalMaterials[v] = { Material = v.Material, MaterialVariant = v.MaterialVariant }
      end
      v.Material = Enum.Material.SmoothPlastic
   elseif v:IsA("MeshPart") then
      if not OriginalMaterials[v] then
         OriginalMaterials[v] = { Material = v.Material, TextureID = v.TextureID }
      end
      v.Material = Enum.Material.SmoothPlastic
      v.TextureID = ""
   elseif v:IsA("Decal") or v:IsA("Texture") then
      if not OriginalMaterials[v] then
         OriginalMaterials[v] = { Transparency = v.Transparency }
      end
      v.Transparency = 1
   end
end

local function EnableAntiLag()
   AntiLagEnabled = true
   OriginalLightingProps.GlobalShadows = Lighting.GlobalShadows
   Lighting.GlobalShadows = false

   for _, v in ipairs(workspace:GetDescendants()) do
      OptimizeObject(v)
   end

   if not TextureMapConnection then
      TextureMapConnection = workspace.DescendantAdded:Connect(function(v)
         if AntiLagEnabled then
            task.wait()
            OptimizeObject(v)
         end
      end)
   end
end

local function DisableAntiLag()
   AntiLagEnabled = false
   
   if TextureMapConnection then
      TextureMapConnection:Disconnect()
      TextureMapConnection = nil
   end

   if OriginalLightingProps.GlobalShadows ~= nil then
      Lighting.GlobalShadows = OriginalLightingProps.GlobalShadows
   end

   for part, data in pairs(OriginalMaterials) do
      if part and part.Parent then
         if part:IsA("BasePart") and not part:IsA("MeshPart") then
            part.Material = data.Material
            if data.MaterialVariant then part.MaterialVariant = data.MaterialVariant end
         elseif part:IsA("MeshPart") then
            part.Material = data.Material
            part.TextureID = data.TextureID
         elseif part:IsA("Decal") or part:IsA("Texture") then
            part.Transparency = data.Transparency
         end
      end
   end
   table.clear(OriginalMaterials)
end

--------------------------------------------------------------------------------
-- CHARACTER CONNECTIONS & PROPERTY LOGIC
--------------------------------------------------------------------------------
local function UpdateCharacterStats()
   if not Humanoid or not Humanoid.Parent then return end
   if WalkSpeedEnabled then
      Humanoid.WalkSpeed = CustomWalkSpeed
   else
      Humanoid.WalkSpeed = 16
   end

   if JumpPowerEnabled then
      Humanoid.UseJumpPower = false
      Humanoid.JumpHeight = CustomJumpPower
   else
      Humanoid.UseJumpPower = false
      Humanoid.JumpHeight = 7.2
   end
end

local propertyConn
local function SetupHumanoidListeners()
   if propertyConn then propertyConn:Disconnect() end
   propertyConn = Humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
      if WalkSpeedEnabled and Humanoid.WalkSpeed ~= CustomWalkSpeed then
         Humanoid.WalkSpeed = CustomWalkSpeed
      end
   end)
end

--------------------------------------------------------------------------------
-- GIAO DIỆN HUD BAY
--------------------------------------------------------------------------------
function CreateFlyHUD()
   if FlyHUD then return end
   
   FlyHUD = Instance.new("ScreenGui")
   FlyHUD.Name = "FlyHUD"
   FlyHUD.ResetOnSpawn = false
   FlyHUD.Parent = CoreGui

   local Container = Instance.new("Frame")
   Container.Size = UDim2.new(0, 50, 0, 160)
   Container.Position = UDim2.new(0, 15, 0.4, -80)
   Container.BackgroundTransparency = 1
   Container.Parent = FlyHUD

   local UIList = Instance.new("UIListLayout")
   UIList.SortOrder = Enum.SortOrder.LayoutOrder
   UIList.Padding = UDim.new(0, 8)
   UIList.Parent = Container

   local function CreateHUDButton(name, text, defaultColor)
      local btn = Instance.new("TextButton")
      btn.Name = name
      btn.Size = UDim2.new(0, 50, 0, 44)
      btn.BackgroundColor3 = defaultColor
      btn.Text = text
      btn.TextColor3 = Color3.fromRGB(255, 255, 255)
      btn.TextSize = 11
      btn.Font = Enum.Font.GothamBold
      btn.Parent = Container

      local corner = Instance.new("UICorner")
      corner.CornerRadius = UDim.new(0, 10)
      corner.Parent = btn
      return btn
   end

   BtnFlyToggle  = CreateHUDButton("BtnFlyToggle", Flying and "FLY\nBẬT" or "FLY\nTẮT", Flying and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(200, 50, 50))
   BtnModeToggle = CreateHUDButton("BtnModeToggle", (FlyMode == "Superman") and "MODE\nSuper" or "MODE\nStand", (FlyMode == "Superman") and Color3.fromRGB(0, 150, 255) or Color3.fromRGB(150, 50, 200))
   BtnPoseToggle = CreateHUDButton("BtnPoseToggle", "POSE\n" .. PoseState, Color3.fromRGB(255, 140, 0))

   BtnFlyToggle.MouseButton1Click:Connect(function()
      if Flying then StopFlying() else StartFlying() end
   end)

   BtnModeToggle.MouseButton1Click:Connect(function()
      FlyMode = (FlyMode == "Superman") and "Stand" or "Superman"
      BtnModeToggle.Text = (FlyMode == "Superman") and "MODE\nSuper" or "MODE\nStand"
      BtnModeToggle.BackgroundColor3 = (FlyMode == "Superman") and Color3.fromRGB(0, 150, 255) or Color3.fromRGB(150, 50, 200)
      if Flying then
         StopFlying()
         StartFlying()
      end
   end)

   BtnPoseToggle.MouseButton1Click:Connect(function()
      PoseState = (PoseState % 4) + 1
      local poseNames = {"Úp Bụng", "Lật Ngửa", "Xoay Ngang", "Ngửa Bụng"}
      BtnPoseToggle.Text = "POSE\n" .. PoseState
      Rayfield:Notify({Title = "Đổi Tư Thế Bay", Content = "Tư thế: " .. poseNames[PoseState], Duration = 1.2})
   end)
end

function RemoveFlyHUD()
   if FlyHUD then
      FlyHUD:Destroy()
      FlyHUD = nil
   end
end

