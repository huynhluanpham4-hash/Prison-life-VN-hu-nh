--------------------------------------------------------------------------------
-- LOGIC ANIMATIONS & FLY ENGINE (ĐÃ FIX KHÔNG LỖI)
--------------------------------------------------------------------------------
local function LoadAnimations()
    local Animator = Humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", Humanoid)
    
    local anim1 = Instance.new("Animation")
    anim1.AnimationId = AnimID_Superman
    pcall(function()
        AnimTrackSuperman = Animator:LoadAnimation(anim1)
        AnimTrackSuperman.Priority = Enum.AnimationPriority.Action4
        AnimTrackSuperman.Looped = true
    end)

    local anim2 = Instance.new("Animation")
    anim2.AnimationId = AnimID_Stand
    pcall(function()
        AnimTrackStand = Animator:LoadAnimation(anim2)
        AnimTrackStand.Priority = Enum.AnimationPriority.Action4
        AnimTrackStand.Looped = true
    end)
end

function StartFlying()
    if Flying or not RootPart or not Humanoid then return end
    Flying = true
    
    CreateFlyHUD()
    if Toggle_HUD_Menu then Toggle_HUD_Menu:Set(true) end
    if Toggle_Fly_Body and not Toggle_Fly_Body.CurrentValue then Toggle_Fly_Body:Set(true) end
    if Toggle_Fly_Menu and not Toggle_Fly_Menu.CurrentValue then Toggle_Fly_Menu:Set(true) end

    if BtnFlyToggle then
       BtnFlyToggle.Text = "FLY\nBẬT"
       BtnFlyToggle.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    end

    Humanoid.PlatformStand = true

    -- Tạo BodyVelocity & BodyGyro chuẩn để hoạt động mượt không bị tụt khỏi Map
    BodyVelocity = Instance.new("BodyVelocity")
    BodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    BodyVelocity.Velocity = Vector3.zero
    BodyVelocity.Parent = RootPart

    BodyGyro = Instance.new("BodyGyro")
    BodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    BodyGyro.P = 10000
    BodyGyro.D = 500
    BodyGyro.Parent = RootPart

    if FlyMode == "Superman" and AnimTrackSuperman then
        AnimTrackSuperman:Play(0.2)
    elseif FlyMode == "Stand" and AnimTrackStand then
        AnimTrackStand:Play(0.2)
    end

    Connection = RunService.RenderStepped:Connect(function()
        if not Flying or not Character or not RootPart or not Humanoid then return end
        
        local camCF = Camera.CFrame
        local moveDir = Humanoid.MoveDirection

        -- Tính toán xoay tư thế
        local baseCF = CFrame.lookAt(RootPart.Position, RootPart.Position + camCF.LookVector)
        if FlyMode == "Superman" then
            if PoseState == 1 then
                BodyGyro.CFrame = baseCF * CFrame.Angles(math.rad(-90), 0, 0)
            elseif PoseState == 2 then
                BodyGyro.CFrame = baseCF * CFrame.Angles(math.rad(-90), math.rad(180), 0)
            elseif PoseState == 3 then
                BodyGyro.CFrame = baseCF * CFrame.Angles(0, math.rad(90), math.rad(-90))
            elseif PoseState == 4 then
                BodyGyro.CFrame = baseCF * CFrame.Angles(math.rad(90), 0, 0)
            end
        else
            BodyGyro.CFrame = CFrame.new(RootPart.Position, RootPart.Position + camCF.LookVector)
        end

        -- Tính toán tốc độ bay
        if moveDir.Magnitude > 0 then
            local moveVector = (camCF.RightVector * moveDir.X) + (camCF.LookVector * -moveDir.Z)
            BodyVelocity.Velocity = moveVector * FlySpeed
        else
            BodyVelocity.Velocity = Vector3.zero
        end
    end)
end

function StopFlying()
    if not Flying then return end
    Flying = false
    
    if Toggle_Fly_Body and Toggle_Fly_Body.CurrentValue then Toggle_Fly_Body:Set(false) end
    if Toggle_Fly_Menu and Toggle_Fly_Menu.CurrentValue then Toggle_Fly_Menu:Set(false) end

    if BtnFlyToggle then
       BtnFlyToggle.Text = "FLY\nTẮT"
       BtnFlyToggle.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end

    if AnimTrackSuperman then AnimTrackSuperman:Stop(0.2) end
    if AnimTrackStand then AnimTrackStand:Stop(0.2) end
    
    if Connection then 
        Connection:Disconnect() 
        Connection = nil 
    end

    if BodyVelocity then BodyVelocity:Destroy() end
    if BodyGyro then BodyGyro:Destroy() end

    if Humanoid then
        Humanoid.PlatformStand = false
        Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

--------------------------------------------------------------------------------
-- EVENT KHỞI TẠO & RESPAWN
--------------------------------------------------------------------------------
local function OnCharacterAdded(newChar)
    Character = newChar
    Humanoid = newChar:WaitForChild("Humanoid")
    RootPart = newChar:WaitForChild("HumanoidRootPart")
    
    StopFlying()
    RemoveFlyHUD()
    LoadAnimations()
    SetupHumanoidListeners()
    UpdateCharacterStats()
end

LoadAnimations()
SetupHumanoidListeners()
UpdateCharacterStats()

LocalPlayer.CharacterAdded:Connect(OnCharacterAdded)

Rayfield:LoadConfiguration()
