-- 7. ESP SYSTEM
local function RemovePlayerESP(p)
    if ESPConnections[p] then
        for _, conn in ipairs(ESPConnections[p].Conns or {}) do
            if conn then conn:Disconnect() end
        end
        if ESPConnections[p].Tag and ESPConnections[p].Tag.Parent then
            ESPConnections[p].Tag:Destroy()
        end
        ESPConnections[p] = nil
    end
end

local function CreatePlayerESP(p)
    if p == LocalPlayer then return end
    RemovePlayerESP(p)

    ESPConnections[p] = { Conns = {}, Tag = nil }

    local function CoreApply(character)
        local head = character:WaitForChild("Head", 5)
        if not head then return end

        local oldTag = head:FindFirstChild("PrisonESP_Tag")
        if oldTag then oldTag:Destroy() end

        local bGui = Instance.new("BillboardGui")
        bGui.Name = "PrisonESP_Tag"
        bGui.AlwaysOnTop = true
        bGui.Size = UDim2.new(0, 200, 0, 20)
        bGui.ExtentsOffset = Vector3.new(0, 1.8, 0)
        bGui.Adornee = head
        bGui.Parent = head
        
        ESPConnections[p].Tag = bGui

        local container = Instance.new("Frame")
        container.Size = UDim2.new(1, 0, 1, 0)
        container.BackgroundTransparency = 1
        container.Parent = bGui

        local layout = Instance.new("UIListLayout")
        layout.FillDirection = Enum.FillDirection.Horizontal
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        layout.VerticalAlignment = Enum.VerticalAlignment.Center
        layout.Padding = UDim.new(0, 5)
        layout.Parent = container

        local dot = Instance.new("Frame")
        dot.Size = UDim2.new(0, 7, 0, 7)
        dot.BackgroundColor3 = GetPlayerTeamColor(p)
        dot.BorderSizePixel = 0
        dot.Rotation = 45
        dot.Parent = container

        local label = Instance.new("TextLabel")
        label.AutomaticSize = Enum.AutomaticSize.X
        label.Size = UDim2.new(0, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = GetPlayerTeamColor(p)
        label.TextStrokeTransparency = 0.2
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.Font = Enum.Font.SourceSansBold
        label.TextSize = 13
        label.Parent = container

        local renderConn = RunService.Heartbeat:Connect(function()
            if not ESPEnabled or not p.Parent or not character.Parent or not head.Parent then
                RemovePlayerESP(p)
                return
            end

            local color = GetPlayerTeamColor(p)
            dot.BackgroundColor3 = color
            label.TextColor3 = color

            local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local targetHRP = character:FindFirstChild("HumanoidRootPart")
            
            if myHRP and targetHRP then
                local dist = math.floor((myHRP.Position - targetHRP.Position).Magnitude)
                label.Text = string.format("%s [@%s] [%dm]", p.DisplayName, p.Name, dist)
            else
                label.Text = string.format("%s [@%s]", p.DisplayName, p.Name)
            end
        end)

        table.insert(ESPConnections[p].Conns, renderConn)
    end

    if p.Character then task.spawn(CoreApply, p.Character) end
    table.insert(ESPConnections[p].Conns, p.CharacterAdded:Connect(function(char) task.spawn(CoreApply, char) end))
end

local function ClearAllESP()
    for p, _ in pairs(ESPConnections) do RemovePlayerESP(p) end
    ESPConnections = {}
end

