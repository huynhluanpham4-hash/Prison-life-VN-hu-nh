local function LoadAnimations()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    
    local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
    
    local a1 = Instance.new("Animation")
    a1.AnimationId = AnimID_Superman
    pcall(function()
        AnimTrackSuperman = animator:LoadAnimation(a1)
        AnimTrackSuperman.Priority = Enum.AnimationPriority.Action4
        AnimTrackSuperman.Looped = true
    end)

    local a2 = Instance.new("Animation")
    a2.AnimationId = AnimID_Stand
    pcall(function()
        AnimTrackStand = animator:LoadAnimation(a2)
        AnimTrackStand.Priority = Enum.AnimationPriority.Action4
        AnimTrackStand.Looped = true
    end)
end

local function StopFlying()
    if not Flying then return end
    Flying = false
    
    if BtnFlyToggle then
        BtnFlyToggle.Text = "FLY\nTẮT"
        BtnFlyToggle.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end

    if AnimTrackSuperman then AnimTrackSuperman:Stop(0.2) end
    if AnimTrackStand then AnimTrackStand:Stop(0.2) end
    
    if Connection then Connection:Disconnect(); Connection = nil end
    if BodyVelocity then BodyVelocity:Destroy() end
    if BodyGyro then BodyGyro:Destroy() end

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

local function StartFlying()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if Flying or not hrp or not hum then return end
    Flying = true

    if BtnFlyToggle then
        BtnFlyToggle.Text = "FLY\nBẬT"
        BtnFlyToggle.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    end

    hum.PlatformStand = true

    BodyVelocity = Instance.new("BodyVelocity")
    BodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    BodyVelocity.Velocity = Vector3.zero
    BodyVelocity.Parent = hrp

    BodyGyro = Instance.new("BodyGyro")
    BodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    BodyGyro.P = 10000
    BodyGyro.D = 500
    BodyGyro.Parent = hrp

    if FlyMode == "Superman" and AnimTrackSuperman then AnimTrackSuperman:Play(0.2)
    elseif FlyMode == "Stand" and AnimTrackStand then AnimTrackStand:Play(0.2) end

    Connection = RunService.RenderStepped:Connect(function()
        if not Flying or not char.Parent or not hrp.Parent or not hum.Parent then return end
        
        local camCF = Camera.CFrame
        local moveDir = hum.MoveDirection
        local baseCF = CFrame.lookAt(hrp.Position, hrp.Position + camCF.LookVector)

        if FlyMode == "Superman" then
            if PoseState == 1 then BodyGyro.CFrame = baseCF * CFrame.Angles(math.rad(-90), 0, 0)
            elseif PoseState == 2 then BodyGyro.CFrame = baseCF * CFrame.Angles(math.rad(-90), math.rad(180), 0)
            elseif PoseState == 3 then BodyGyro.CFrame = baseCF * CFrame.Angles(0, math.rad(90), math.rad(-90))
            elseif PoseState == 4 then BodyGyro.CFrame = baseCF * CFrame.Angles(math.rad(90), 0, 0) end
        else
            BodyGyro.CFrame = CFrame.new(hrp.Position, hrp.Position + camCF.LookVector)
        end

        if moveDir.Magnitude > 0 then
            local moveVector = (camCF.RightVector * moveDir.X) + (camCF.LookVector * -moveDir.Z)
            BodyVelocity.Velocity = moveVector * FlySpeed
        else
            BodyVelocity.Velocity = Vector3.zero
        end
    end)
end

