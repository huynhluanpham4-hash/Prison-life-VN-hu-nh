local function GetPlayerTeamColor(p)
    if not p then return TeamColors.Neutral end
    if p.Team and TeamColors[p.Team.Name] then return TeamColors[p.Team.Name] end
    if p:FindFirstChild("TeamColor") then
        local tName = p.TeamColor.Name
        if tName == "Bright blue" then return TeamColors.Guards end
        if tName == "Bright orange" then return TeamColors.Inmates end
        if tName == "Bright red" then return TeamColors.Criminals end
    end
    return TeamColors.Neutral
end

local function AntiBanTween(targetCFrame)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if ActiveTweens[hrp] then ActiveTweens[hrp]:Cancel() end
    local tween = TweenService:Create(hrp, TweenInfo.new(0.12, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    ActiveTweens[hrp] = tween
    tween:Play()
    tween.Completed:Wait()
    ActiveTweens[hrp] = nil
end

local function UpdateCharacterStats()
