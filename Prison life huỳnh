    hum.WalkSpeed = WalkSpeedEnabled and CustomWalkSpeed or 16
    hum.UseJumpPower = false
    hum.JumpHeight = JumpPowerEnabled and CustomJumpPower or 7.2
end

-- 5. ANTI-LAG LOGIC
local function IsPlayerCharacter(object)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and object:IsDescendantOf(p.Character) then return true end
    end
    return false
end

local function OptimizeObject(v)
    if not AntiLagEnabled or (KeepPlayerSkins and IsPlayerCharacter(v)) then return end

    if v:IsA("BasePart") and not v:IsA("MeshPart") then
        if not OriginalMaterials[v] then OriginalMaterials[v] = { Material = v.Material, MaterialVariant = v.MaterialVariant } end
        v.Material = Enum.Material.SmoothPlastic
    elseif v:IsA("MeshPart") then
        if not OriginalMaterials[v] then OriginalMaterials[v] = { Material = v.Material, TextureID = v.TextureID } end
        v.Material = Enum.Material.SmoothPlastic
        v.TextureID = ""
    elseif v:IsA("Decal") or v:IsA("Texture") then
        if not OriginalMaterials[v] then OriginalMaterials[v] = { Transparency = v.Transparency } end
        v.Transparency = 1
    end
end

local function EnableAntiLag()
    AntiLagEnabled = true
    OriginalLightingProps.GlobalShadows = Lighting.GlobalShadows
    Lighting.GlobalShadows = false

    for _, v in ipairs(workspace:GetDescendants()) do OptimizeObject(v) end
    if not TextureMapConnection then
        TextureMapConnection = workspace.DescendantAdded:Connect(function(v)
            if AntiLagEnabled then task.wait(); OptimizeObject(v) end
        end)
    end
end

local function DisableAntiLag()
    AntiLagEnabled = false
    if TextureMapConnection then TextureMapConnection:Disconnect(); TextureMapConnection = nil end
    if OriginalLightingProps.GlobalShadows ~= nil then Lighting.GlobalShadows = OriginalLightingProps.GlobalShadows end

    for part, data in pairs(OriginalMaterials) do
        if part and part.Parent then
            if part:IsA("BasePart") and not part:IsA("MeshPart") then
                part.Material = data.Material
                if data.MaterialVariant then part.MaterialVariant = data.MaterialVariant end
            elseif part:IsA("MeshPart") then
                part.Material = data.Material
                part.TextureID = data.TextureID
            elseif part:IsA("Decal") or part:IsA("Texture") then
                part.Transparency = data.Transparency
            end
        end
    end
    table.clear(OriginalMaterials)
end

