-- Loop quản lý Platform & UnderVelocity
RunService.Heartbeat:Connect(function()
    if not Enabled then return end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if Height >= 0 then
        Platform.CanCollide = true
        Platform.Position = Vector3.new(hrp.Position.X, BaseY + Height, hrp.Position.Z)
    else
        Platform.CanCollide = false
        Platform.Position = Vector3.new(0, -1000, 0)
        local targetY = BaseY + Height + 3.5
        if math.abs(hrp.Position.Y - targetY) > 1 then
            hrp.CFrame = CFrame.new(hrp.Position.X, targetY, hrp.Position.Z)
        end
    end
end)

